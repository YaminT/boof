{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // dist/ is produced by tsup; tsc is type-check only, so emit declarations to
    // a throwaway directory.
    "outDir": "./.tsc-typecheck",
    "rootDir": "./src",
    "composite": true
  },
  "references": [{ "path": "../heart" }, { "path": "../runner" }, { "path": "../heart-server" }],
  "include": ["src/**/*"]
}
