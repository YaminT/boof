{
  "name": "@boof/desktop",
  "version": "0.6.0",
  "private": true,
  "description": "Boof Runner desktop app (Electron) \u2014 runs the server and UI in one window",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsup",
    "start": "electron .",
    "typecheck": "tsc -b",
    "stage": "node scripts/stage-app.mjs",
    "check:staged-app": "node scripts/check-staged-app.mjs",
    "dist": "npm run stage && electron-builder --publish never",
    "dist:mac": "npm run stage && electron-builder --mac --publish never",
    "dist:win": "npm run stage && electron-builder --win --publish never",
    "dist:linux": "npm run stage && electron-builder --linux --publish never"
  },
  "dependencies": {
    "@boof/boof": "*",
    "@boof/runner": "*",
    "@boof/heart": "*",
    "@boof/heart-server": "*",
    "@hono/node-server": "^2.1.6",
    "chokidar": "^6.0.0",
    "gray-matter": "^4.0.3",
    "hono": "^4.13.17",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3"
  }
}
